<% layout('layouts/boilerplate') -%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h2><%=listing.title%></h2>
        </div>

        <div class="card col-6 offset-3 show-card listing-card">
            <div class="listing-gallery mb-3">
                <% 
                    let mainImgUrl = "https://via.placeholder.com/800x400?text=No+Image+Available";
                    if(listing.images && listing.images.length > 0) {
                        mainImgUrl = listing.images[0].url;
                    } else if(listing.image && listing.image.url) {
                        mainImgUrl = listing.image.url;
                    }
                %>
                <!-- Main Featured Image -->
                <div class="main-image-container mb-2">
                    <img id="mainImage" src="<%= mainImgUrl %>" class="img-fluid w-100 rounded show-img" style="height: 400px; object-fit: cover;" alt="Featured Image">
                </div>
                
                <!-- Thumbnails Gallery -->
                <% if(listing.images && listing.images.length > 1) { %>
                    <div class="thumbnails-container d-flex gap-2 overflow-auto py-1" style="scrollbar-width: thin;">
                        <% listing.images.forEach((img, i) => { %>
                            <img src="<%= img.url %>" 
                                 class="thumbnail-img rounded" 
                                 style="height: 80px; width: 120px; min-width: 120px; object-fit: cover; cursor: pointer; opacity: <%= i === 0 ? '1' : '0.6' %>; transition: opacity 0.3s ease, border 0.3s ease; border: <%= i === 0 ? '2px solid black' : '2px solid transparent' %>;"
                                 onclick="updateMainImage('<%= img.url %>', this)" 
                                 alt="Thumbnail <%= i + 1 %>">
                        <% }) %>
                    </div>
                    <script>
                        function updateMainImage(newUrl, thumbnailElement) {
                            // Update main image source
                            document.getElementById('mainImage').src = newUrl;
                            
                            // Reset styles for all thumbnails
                            document.querySelectorAll('.thumbnail-img').forEach(el => {
                                el.style.opacity = '0.6';
                                el.style.border = '2px solid transparent';
                            });
                            
                            // Highlight the clicked thumbnail
                            thumbnailElement.style.opacity = '1';
                            thumbnailElement.style.border = '2px solid black';
                        }
                    </script>
                <% } %>
            </div>
            <div class="card-body">
                <p class="card-text"><i>Owned By : <%=listing.owner.username%></i></p>
                <p class="card-text">
                    <%= listing.description%> <br>
                    &#8377;<%= listing.price.toLocaleString("en-IN")%> <br>
                    <%= listing.location%> <br>
                    <%= listing.country%> <br>
                </p>
            </div>
        </div>
    </div>

    <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="btns">
        <a href="/listings/<%=listing.id%>/edit" class="btn btn-dark edit-btn show-btns col-1 offset-3">Edit Listing</a>
        <form action="/listings/<%=listing.id%>?_method=DELETE" method="post">
        <button class="btn btn-danger offset-3 show-btns">Delete Listing</button>
    </form>
    </div>
    <% } %>
    <hr>
    <div class="col-8 offset-3 mb-3 mt-3">
        <% if(currUser){ %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id%>/reviews" method="POST" novalidate class="needs-validation">
                
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please Add Some Comments</div>
                </div>

                <button class="btn btn-outline-dark">Submit</button> 
            </form>
        <% } %>
        
        <% if(listing.reviews.length>0){ %>
        <div class="row">
            <p><b>Reviews</b></p>
            <% for(review of listing.reviews){ %>
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">@<%=review.author.username%></h5>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                        <p class="card-text"><%= review.comment %></p>
                        <form action="/listings/<%=listing.id%>/reviews/<%=review.id%>?_method=DELETE" class="mb-3" method="POST">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
    </div>
</body>
